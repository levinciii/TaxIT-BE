# App Settings
APP_NAME="App Name"
NODE_ENV=development
PORT=3000

# Generate JWT Secrets Script
# node -e "const crypto=require('crypto'); const id=()=>crypto.randomUUID(); console.log('JWT_SECRET=taxit-'+id()); console.log('REFRESH_JWT_SECRET=taxit-'+id()); console.log('SECRET_KEY=taxit-'+id());"

# Token Settings
JWT_SECRET="Use the script above to generate JWT_SECRET"
REFRESH_JWT_SECRET="Use the script above to generate REFRESH_JWT_SECRET"
SECRET_KEY="Use the script above to generate SECRET_KEY"

# Your own PostgreSQL login (see README section 1). URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/AppName

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
